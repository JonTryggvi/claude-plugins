#!/usr/bin/env python3
"""Read and maintain the Avista knowledge base (Avista/avista-knowledge-base).

Usage:
  kb where [--set PATH]          print the knowledge base path, or remember one
  kb config [KEY [VALUE|--unset]] read or set ~/.claude/avista-kb/config (path, share, setup, snooze)
  kb sync                        fast-forward the knowledge base from its remote, if it has one
  kb find TERM                   features and sites whose slug, title, domain or client match
  kb feature SLUG                handoff + overview + each linked site, with link problems
  kb site DOMAIN                 the site page + features that link to it
  kb new-feature SLUG TITLE      create features/SLUG/ from templates (never overwrites)
  kb link SLUG DOMAIN            add DOMAIN to the feature's sites: and SLUG to the site's features:
  kb status SLUG STATUS          set the feature's status; adds the draft banner for draft, removes it otherwise
  kb tracked DOMAIN|REPO …       features already tracking these sites or repos (owner/repo or a
                                 git remote URL), with status; no output = not tracked
  kb touch FILE                  set updated: to today on a knowledge base page

Locating the knowledge base: $AVISTA_KB_DIR, then ~/.claude/avista-kb/config (path=…), then
~/Dropbox/dev/avista-knowledge-base and ~/dev/avista-knowledge-base. Exit 3 means not found.
Only the standard library is used; the frontmatter parser handles the subset the knowledge base templates use.
"""
import datetime
import os
import re
import subprocess
import sys
from pathlib import Path

CONFIG = Path.home() / ".claude" / "avista-kb" / "config"
FALLBACKS = [Path.home() / "Dropbox" / "dev" / "avista-knowledge-base", Path.home() / "dev" / "avista-knowledge-base"]
TODAY = datetime.date.today().isoformat()
STATUSES = ["draft", "active", "paused", "done", "retired"]
BANNER = "> **Draft:** written while the work is in progress, so it may be incomplete or out of date."


def die(msg: str, code: int = 1) -> None:
  print(msg, file=sys.stderr)
  sys.exit(code)


def is_kb(p: Path) -> bool:
  return (p / "templates" / "site.md").is_file() and (p / "features").is_dir()


CONFIG_KEYS = {
  "path": "where the knowledge base clone is",
  "share": "pr | push | local: what kb-handoff does after committing",
  "setup": "done once kb-setup has finished",
  "snooze": "YYYY-MM-DD: don't offer kb-setup before this date",
}


def read_config() -> dict:
  conf = {}
  if CONFIG.is_file():
    for line in CONFIG.read_text().splitlines():
      if "=" in line and not line.lstrip().startswith("#"):
        k, v = line.split("=", 1)
        conf[k.strip()] = v.strip()
  return conf


def write_config(conf: dict) -> None:
  CONFIG.parent.mkdir(parents=True, exist_ok=True)
  CONFIG.write_text("".join(f"{k}={v}\n" for k, v in conf.items()))


def kb_dir() -> Path:
  candidates = []
  if os.environ.get("AVISTA_KB_DIR"):
    candidates.append(Path(os.environ["AVISTA_KB_DIR"]).expanduser())
  if read_config().get("path"):
    candidates.append(Path(read_config()["path"]).expanduser())
  candidates += FALLBACKS
  for c in candidates:
    if is_kb(c):
      return c
  die("KB_NOT_FOUND: no clone of the knowledge base found. Clone it with: gh repo clone Avista/avista-knowledge-base, or point to one with: kb where --set <path>", 3)


# --- frontmatter -----------------------------------------------------------

def strip_comment(v: str) -> str:
  # A ' #' outside quotes starts a comment.
  out, quote = [], None
  for i, ch in enumerate(v):
    if quote:
      if ch == quote:
        quote = None
    elif ch in "\"'":
      quote = ch
    elif ch == "#" and (i == 0 or v[i - 1] == " "):
      break
    out.append(ch)
  return "".join(out).strip()


def scalar(v: str):
  v = strip_comment(v)
  if v in ("", "null", "~"):
    return None
  if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
    return v[1:-1]
  if v.startswith("[") and v.endswith("]"):
    inner = v[1:-1].strip()
    return [scalar(x) for x in inner.split(",")] if inner else []
  return v


def split_page(text: str):
  if not text.startswith("---\n"):
    return [], text
  end = text.find("\n---", 4)
  if end == -1:
    return [], text
  return text[4:end].split("\n"), text[end + 4:].lstrip("\n")


def parse(path: Path) -> dict:
  lines, _ = split_page(path.read_text())
  data, key, item = {}, None, None
  for raw in lines:
    if not raw.strip() or raw.lstrip().startswith("#"):
      continue
    top = re.match(r"^([A-Za-z_][\w-]*):\s*(.*)$", raw)
    if top:
      key, val = top.group(1), top.group(2)
      data[key] = scalar(val) if strip_comment(val) else []
      item = None
      continue
    li = re.match(r"^\s*-\s*(.*)$", raw)
    if li and key is not None:
      body = li.group(1)
      kv = re.match(r"^([A-Za-z_][\w-]*):\s*(.*)$", body)
      if kv:
        item = {kv.group(1): scalar(kv.group(2))}
        data[key].append(item)
      else:
        data[key].append(scalar(body))
        item = None
      continue
    kv = re.match(r"^\s+([A-Za-z_][\w-]*):\s*(.*)$", raw)
    if kv and isinstance(item, dict):
      item[kv.group(1)] = scalar(kv.group(2))
  return data


def set_key(path: Path, key: str, value: str) -> None:
  """Replace a top-level `key:` line in the frontmatter, keeping any trailing comment."""
  text = path.read_text()
  lines, body = split_page(text)
  for i, raw in enumerate(lines):
    m = re.match(rf"^{re.escape(key)}:\s*(.*)$", raw)
    if m:
      comment = ""
      rest = m.group(1)
      stripped = strip_comment(rest)
      if len(rest.strip()) > len(stripped):
        comment = "  " + rest.strip()[len(stripped):].strip()
      lines[i] = f"{key}: {value}{comment}"
      break
  else:
    lines.append(f"{key}: {value}")
  path.write_text("---\n" + "\n".join(lines) + "\n---\n\n" + body)


def flow(items) -> str:
  return "[" + ", ".join(items) + "]"


# --- helpers ---------------------------------------------------------------

def norm_domain(d: str) -> str:
  d = d.strip().lower()
  d = re.sub(r"^https?://", "", d)
  d = re.sub(r"^www\.", "", d)
  return d.rstrip("/")


def site_file(kb: Path, domain: str) -> Path:
  return kb / "sites" / (norm_domain(domain).replace("/", "--") + ".md")


def feature_dir(kb: Path, slug: str) -> Path:
  return kb / "features" / slug


def as_list(v) -> list:
  if v is None:
    return []
  return v if isinstance(v, list) else [v]


def days_old(updated):
  try:
    return (datetime.date.today() - datetime.date.fromisoformat(str(updated))).days
  except ValueError:
    return None


def show(path: Path, kb: Path) -> None:
  print(f"\n===== {path.relative_to(kb)} =====")
  print(path.read_text().rstrip())


# --- commands --------------------------------------------------------------

def cmd_where(args: list) -> None:
  if len(args) == 2 and args[0] == "--set":
    p = Path(args[1]).expanduser().resolve()
    if not is_kb(p):
      die(f"{p} does not look like the knowledge base repo (no templates/site.md)")
    conf = read_config()
    conf["path"] = str(p)
    write_config(conf)
    print(p)
    return
  print(kb_dir())


def cmd_config(args: list) -> None:
  conf = read_config()
  if not args:
    for k, v in conf.items():
      print(f"{k}={v}")
    return
  key = args[0]
  if key not in CONFIG_KEYS:
    die("keys: " + "; ".join(f"{k} ({d})" for k, d in CONFIG_KEYS.items()), 2)
  if len(args) == 1:
    print(conf.get(key, ""))
    return
  if args[1] == "--unset":
    conf.pop(key, None)
  elif key == "share" and args[1] not in ("pr", "push", "local"):
    die("share must be pr, push or local", 2)
  else:
    conf[key] = args[1]
  write_config(conf)
  print(f"{key}={conf.get(key, '')}")


def git(kb: Path, *a: str) -> subprocess.CompletedProcess:
  return subprocess.run(["git", "-C", str(kb), *a], capture_output=True, text=True)


def cmd_sync(args: list) -> None:
  kb = kb_dir()
  if not git(kb, "remote").stdout.strip():
    print(f"no remote: using the local knowledge base at {kb} as is")
    return
  dirty = git(kb, "status", "--porcelain").stdout.strip()
  branch = git(kb, "branch", "--show-current").stdout.strip()
  if dirty or branch != "main":
    print(f"not syncing: branch={branch or '?'} dirty={'yes' if dirty else 'no'}; reading the knowledge base as it is")
    return
  r = git(kb, "pull", "--ff-only", "--quiet")
  print("synced" if r.returncode == 0 else f"pull failed, reading local copy: {r.stderr.strip()}")


def cmd_find(args: list) -> None:
  if not args:
    die("usage: kb find TERM", 2)
  kb, term = kb_dir(), " ".join(args).lower()
  hits = 0
  for ov in sorted((kb / "features").glob("*/overview.md")):
    d = parse(ov)
    hay = " ".join(str(x) for x in [ov.parent.name, d.get("title"), d.get("owner"),
                                     *as_list(d.get("sites")), *as_list(d.get("repos"))]).lower()
    if term in hay:
      hits += 1
      print(f"feature  {ov.parent.name:30} {d.get('title') or ''} [{d.get('status') or '?'}] updated {d.get('updated') or '?'}")
  for sp in sorted((kb / "sites").glob("*.md")):
    d = parse(sp)
    hay = " ".join(str(x) for x in [d.get("domain"), d.get("client"), *as_list(d.get("features"))]).lower()
    if term in hay:
      hits += 1
      print(f"site     {d.get('domain') or sp.stem:30} {d.get('client') or ''} features={flow(as_list(d.get('features')))}")
  for cp in sorted((kb / "clients").glob("*.md")):
    d = parse(cp)
    if term in f"{cp.stem} {d.get('client')}".lower():
      hits += 1
      print(f"client   {cp.stem:30} {d.get('client') or ''}")
  if not hits:
    print(f"no knowledge base page matches '{term}' (searched features/*/overview.md, sites/, clients/ frontmatter)")


def cmd_feature(args: list) -> None:
  if len(args) != 1:
    die("usage: kb feature SLUG", 2)
  kb, slug = kb_dir(), args[0]
  fd = feature_dir(kb, slug)
  if not fd.is_dir():
    die(f"FEATURE_NOT_FOUND: features/{slug}/ — try: kb find {slug}", 4)
  problems = []
  for name in ("handoff.md", "overview.md"):
    p = fd / name
    if p.is_file():
      show(p, kb)
    else:
      problems.append(f"missing features/{slug}/{name}")
  for extra in sorted(fd.glob("*.md")):
    if extra.name not in ("handoff.md", "overview.md"):
      show(extra, kb)
  ov = parse(fd / "overview.md") if (fd / "overview.md").is_file() else {}
  ho = parse(fd / "handoff.md") if (fd / "handoff.md").is_file() else {}
  if ov.get("status") == "draft":
    problems.insert(0, "DRAFT: written while the work is in progress, so treat it as working notes, not a finished record")
  for domain in as_list(ov.get("sites")):
    sp = site_file(kb, str(domain))
    if not sp.is_file():
      problems.append(f"site {domain} is listed but sites/{sp.name} does not exist")
      continue
    show(sp, kb)
    sd = parse(sp)
    if slug not in as_list(sd.get("features")):
      problems.append(f"sites/{sp.name} does not list '{slug}' in features:")
    for c in as_list(sd.get("code")):
      if isinstance(c, dict) and c.get("lives") == "server-only":
        problems.append(f"{domain}: {c.get('path')} is server-only (no repo)")
  for sp in sorted((kb / "sites").glob("*.md")):
    sd = parse(sp)
    if slug in as_list(sd.get("features")) and str(sd.get("domain")) not in [str(x) for x in as_list(ov.get("sites"))]:
      problems.append(f"sites/{sp.name} lists '{slug}' but the overview's sites: does not include {sd.get('domain')}")
  for label, d in (("handoff", ho), ("overview", ov)):
    age = days_old(d.get("updated"))
    if age is not None and age > 60:
      problems.append(f"{label} last updated {d.get('updated')} ({age} days ago)")
  print("\n===== Knowledge base problems =====")
  print("\n".join(f"- {p}" for p in problems) if problems else "none")


def cmd_site(args: list) -> None:
  if len(args) != 1:
    die("usage: kb site DOMAIN", 2)
  kb = kb_dir()
  sp = site_file(kb, args[0])
  if not sp.is_file():
    die(f"SITE_NOT_FOUND: sites/{sp.name} — seed it with: {kb}/scripts/seed-sites.sh {norm_domain(args[0])}", 4)
  show(sp, kb)
  domain = parse(sp).get("domain")
  linked = [ov.parent.name for ov in sorted((kb / "features").glob("*/overview.md"))
            if str(domain) in [str(x) for x in as_list(parse(ov).get("sites"))]]
  print(f"\nfeatures whose overview lists this site: {flow(linked) if linked else 'none'}")


def cmd_new_feature(args: list) -> None:
  if len(args) < 2:
    die("usage: kb new-feature SLUG TITLE", 2)
  kb, slug, title = kb_dir(), args[0], " ".join(args[1:])
  if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", slug):
    die("slug must be lowercase letters, digits and dashes", 2)
  fd = feature_dir(kb, slug)
  if fd.exists():
    die(f"features/{slug}/ already exists; not overwriting", 5)
  fd.mkdir(parents=True)
  pairs = {"overview.md": "feature-overview.md", "handoff.md": "feature-handoff.md"}
  for dst, src in pairs.items():
    text = (kb / "templates" / src).read_text()
    text = text.replace("example-feature", slug).replace("Example feature", title)
    text = re.sub(r"^updated: .*$", f"updated: {TODAY}", text, flags=re.M)
    (fd / dst).write_text(text)
    print(f"created features/{slug}/{dst}")


def cmd_link(args: list) -> None:
  if len(args) != 2:
    die("usage: kb link SLUG DOMAIN", 2)
  kb, slug, domain = kb_dir(), args[0], norm_domain(args[1])
  ov = feature_dir(kb, slug) / "overview.md"
  sp = site_file(kb, domain)
  if not ov.is_file():
    die(f"FEATURE_NOT_FOUND: features/{slug}/overview.md — create it with: kb new-feature {slug} \"Title\"", 4)
  if not sp.is_file():
    die(f"SITE_NOT_FOUND: sites/{sp.name} — seed it with: {kb}/scripts/seed-sites.sh {domain}", 4)
  sites = [str(x) for x in as_list(parse(ov).get("sites"))]
  if domain not in sites:
    set_key(ov, "sites", flow(sites + [domain]))
    set_key(ov, "updated", TODAY)
    print(f"features/{slug}/overview.md: sites += {domain}")
  feats = [str(x) for x in as_list(parse(sp).get("features"))]
  if slug not in feats:
    set_key(sp, "features", flow(feats + [slug]))
    set_key(sp, "updated", TODAY)
    print(f"sites/{sp.name}: features += {slug}")


def set_banner(path: Path, on: bool) -> None:
  """Add the draft banner under the first '# ' heading, or remove it."""
  lines = path.read_text().split("\n")
  had = [i for i, l in enumerate(lines) if l.startswith("> **Draft:**")]
  for i in reversed(had):
    del lines[i]
    if i < len(lines) and lines[i] == "" and i > 0 and lines[i - 1] == "":
      del lines[i]
  if on:
    head = next((i for i, l in enumerate(lines) if l.startswith("# ")), None)
    if head is not None:
      lines[head + 1:head + 1] = ["", BANNER]
  path.write_text("\n".join(lines))


def cmd_status(args: list) -> None:
  if len(args) != 2 or args[1] not in STATUSES:
    die(f"usage: kb status SLUG {{{'|'.join(STATUSES)}}}", 2)
  kb, slug, status = kb_dir(), args[0], args[1]
  fd = feature_dir(kb, slug)
  ov = fd / "overview.md"
  if not ov.is_file():
    die(f"FEATURE_NOT_FOUND: features/{slug}/overview.md", 4)
  old = parse(ov).get("status")
  set_key(ov, "status", status)
  set_key(ov, "updated", TODAY)
  for name in ("overview.md", "handoff.md"):
    if (fd / name).is_file():
      set_banner(fd / name, status == "draft")
  print(f"features/{slug}: status {old} -> {status}")


def repo_slug(s: str):
  """Return 'owner/repo' (lowercased) for a repo slug or git remote URL, or None for a domain."""
  s = s.strip()
  m = re.match(r"^(?:git@[^:]+:|https?://[^/]+/|ssh://[^/]+/)?([\w-]+)/([\w.-]+?)(?:\.git)?/?$", s)
  if not m or "." in m.group(1):
    return None
  return f"{m.group(1)}/{m.group(2)}".lower()


def cmd_tracked(args: list) -> None:
  if not args:
    die("usage: kb tracked DOMAIN|OWNER/REPO|REMOTE_URL [...]", 2)
  kb = kb_dir()
  repos = {repo_slug(a) for a in args if repo_slug(a)}
  domains = {norm_domain(a) for a in args if not repo_slug(a)}
  for ov in sorted((kb / "features").glob("*/overview.md")):
    d = parse(ov)
    hit = sorted(domains & {norm_domain(str(x)) for x in as_list(d.get("sites"))})
    hit += sorted(repos & {str(x).lower() for x in as_list(d.get("repos"))})
    if hit:
      print(f"{ov.parent.name}\t{d.get('status') or '?'}\t{','.join(hit)}\t{d.get('title') or ''}")


def cmd_touch(args: list) -> None:
  if len(args) != 1:
    die("usage: kb touch FILE", 2)
  p = Path(args[0])
  if not p.is_file():
    p = kb_dir() / args[0]
  set_key(p, "updated", TODAY)
  print(f"{p}: updated: {TODAY}")


COMMANDS = {
  "where": cmd_where,
  "config": cmd_config,
  "sync": cmd_sync,
  "find": cmd_find,
  "feature": cmd_feature,
  "site": cmd_site,
  "new-feature": cmd_new_feature,
  "link": cmd_link,
  "status": cmd_status,
  "tracked": cmd_tracked,
  "touch": cmd_touch,
}

if __name__ == "__main__":
  if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
    die(__doc__, 2)
  COMMANDS[sys.argv[1]](sys.argv[2:])
