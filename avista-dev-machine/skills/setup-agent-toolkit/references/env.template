# ~/.claude/.env — Avista token store
#
# This file must be mode 0600 (owner read/write only):
#     chmod 600 ~/.claude/.env
#
# Consumers source it rather than exporting globally:
#     set -a; . ~/.claude/.env; set +a
#
# Fill in ONLY the keys your role needs; delete the rest. Replace each
# placeholder with the real value — never commit this file anywhere, and never
# paste a value into a chat, an issue, or a note.
#
# Values below are placeholders, not real credentials.

# ── Figma ─────────────────────────────────────────────────────────────────────
# figma.com/settings → Personal access tokens → Create new token
# Scope: "File content (read)". Rotate every 90 days.
# Read by: avista-figma-import, and the REST screenshot export in the house rules.
FIGMA_TOKEN=figd_REPLACE_ME

# ── GitHub ────────────────────────────────────────────────────────────────────
# github.com/settings/tokens → "Tokens (classic)" → scopes: repo, workflow
# Must be CLASSIC (ghp_…). A fine-grained token (github_pat_…) often cannot
# trigger release builds and shows up as a 403.
AVISTA_GITHUB_TOKEN=ghp_REPLACE_ME

# ── ActiveCollab ──────────────────────────────────────────────────────────────
# The URL is not a secret — write it as-is.
ACTIVECOLLAB_URL=https://active.avista.is
# Do NOT hand-write the token. Run the `activecollab-setup` skill: it exchanges
# the 1Password-held login for a long-lived token and writes it here for you.
# ACTIVECOLLAB_TOKEN=

# ── EasyCron (optional) ───────────────────────────────────────────────────────
# EasyCron account → API settings. Read by scheduled-job checks.
# EASY_CRON=REPLACE_ME

# ── Lichess (optional, personal) ──────────────────────────────────────────────
# lichess.org/account/oauth/token — read by avista-chess.
# LICHESS_TOKEN=REPLACE_ME
