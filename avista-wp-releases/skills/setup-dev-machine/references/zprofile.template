# ─── .zprofile ────────────────────────────────────────────────────────────────
# Runs once per login shell. Sets up the environment and loads the modular
# ~/.zsh/*.zsh config files (env, git, ssh, …).

eval "$(/opt/homebrew/bin/brew shellenv)"

export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && . "/opt/homebrew/opt/nvm/nvm.sh"
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && . "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"

# Source all child config files in ~/.zsh/
for _f in "$HOME/.zsh"/*.zsh; do
  [[ -f "$_f" ]] && source "$_f"
done
unset _f

# Smart re-source: load only files changed since the last run.
# Usage: sb        → source changed files only
#        sb --all  → force-source everything
sb() {
  local dir="$HOME/.zsh"
  local marker="$dir/.last_sourced"
  local count=0
  for f in "$dir"/*.zsh; do
    [[ -f "$f" ]] || continue
    if [[ "$1" == "--all" ]] || [[ ! -f "$marker" ]] || [[ "$f" -nt "$marker" ]]; then
      echo "  ↻  $(basename $f)"
      source "$f"
      (( count++ ))
    fi
  done
  touch "$marker"
  (( count == 0 )) && echo "sb: nothing to source — all files up to date." || echo "sb: sourced $count file(s)."
}

alias sbs="source ~/.zshrc"
